{
  "name": "DepositAddress",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "network": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "symbol",
    "network",
    "address"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "user"
      }
    },
    "delete": {
      "user_condition": {
        "role": "user"
      }
    }
  }
}
